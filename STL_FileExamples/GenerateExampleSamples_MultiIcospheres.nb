 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Create", " ", "a", " ", "Single", " ", "Icosphere"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"n", "=", "40"}], ";"}], " ", 
